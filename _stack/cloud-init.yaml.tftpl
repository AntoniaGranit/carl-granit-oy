#cloud-config
package_update: true
package_upgrade: true

users:
  - name: devops
    groups: sudo, docker
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${olle_key}
      - ${antonia_key}
  - name: ci
    groups: docker
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:/usr/bin/docker,/usr/bin/docker-compose,/usr/bin/systemctl reload nginx,/usr/bin/certbot
    ssh_authorized_keys:
      - ${ci_key}

packages:
  - nginx
  - certbot
  - python3-certbot-nginx
  - ufw
  - fail2ban
  - unattended-upgrades

ssh_pwauth: false

write_files:
  - path: /etc/ssh/sshd_config.d/hardening.conf
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      PubkeyAuthentication yes
      MaxAuthTries 3
      LoginGraceTime 20
      X11Forwarding no
      AllowUsers devops ci

  - path: /etc/fail2ban/jail.local
    content: |
      [DEFAULT]
      bantime = 1h
      findtime = 10m
      maxretry = 5

      [sshd]
      enabled = true
      port = 22
      filter = sshd
      logpath = /var/log/auth.log

  - path: /etc/nginx/sites-available/carl-granit-oy
    content: |
      server {
          listen 80;
          listen [::]:80;
          server_name ${domain} www.${domain};

          location / {
              proxy_pass http://127.0.0.1:3000;
              proxy_http_version 1.1;
              proxy_set_header Upgrade $http_upgrade;
              proxy_set_header Connection 'upgrade';
              proxy_set_header Host $host;
              proxy_set_header X-Real-IP $remote_addr;
              proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
              proxy_set_header X-Forwarded-Proto $scheme;
              proxy_cache_bypass $http_upgrade;
          }
      }

runcmd:
  # Docker
  - curl -fsSL https://get.docker.com | sh
  - systemctl enable docker
  - systemctl start docker
  - apt-get install -y docker-compose-plugin

  # App directories
  - mkdir -p /var/www/carl-granit-oy
  - mkdir -p /var/backups/carl-granit-oy
  - chown -R ci:ci /var/www/carl-granit-oy
  - chown -R ci:ci /var/backups/carl-granit-oy

  # Nginx
  - ln -sf /etc/nginx/sites-available/carl-granit-oy /etc/nginx/sites-enabled/
  - rm -f /etc/nginx/sites-enabled/default
  - nginx -t && systemctl enable nginx && systemctl restart nginx

  # UFW
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow 22/tcp
  - ufw allow 80/tcp
  - ufw allow 443/tcp
  - ufw --force enable

  # Fail2ban
  - systemctl enable fail2ban
  - systemctl start fail2ban

  # SSH hardening
  - systemctl restart sshd

  # Automatic security updates
  - systemctl enable unattended-upgrades
  - systemctl start unattended-upgrades
